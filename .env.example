# Copy to .env.local and fill in the key. Never commit .env.local.
SARVAM_API_KEY=

# Sarvam chat model. Sarvam retired sarvam-30b, so sarvam-105b now answers everything.
# These two lines are optional; the code already defaults to sarvam-105b.
SARVAM_CHAT_MODEL_FAST=sarvam-105b
SARVAM_CHAT_MODEL_STRONG=sarvam-105b

# Cost guards. One question is one model call in the normal case.
ASSISTANT_HOURLY_LIMIT=30
ASSISTANT_SESSION_LIMIT=10

ASSISTANT_EVAL_BASE_URL=http://localhost:3000
